# ── Root / Docker Compose environment ─────────────────────────────
# Used by docker-compose.yml to provision MySQL and Redis.

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=tsgecart
MYSQL_USER=tsgecart
MYSQL_PASSWORD=change_me_app

# Redis
REDIS_PASSWORD=change_me_redis

# Exposed host ports
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=4000
FRONTEND_PORT=5173
