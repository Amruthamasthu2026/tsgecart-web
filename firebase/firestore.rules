rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// TSG eCart — Firestore Security Rules foundation (Phase 1)
//
// Scope for this phase: default-deny everything, provide the role/ownership
// helper functions the audit (docs/firebase-migration-audit.md §31) commits
// to, and leave clearly-labeled placeholder sections for each future
// collection. No collection is opened for read/write yet — that happens
// incrementally, one domain per migration phase, per the rollout plan in
// the audit (§28).
//
// Authority model (see audit §21.2, §31):
//   - Firebase custom claims (`request.auth.token.role`,
//     `request.auth.token.permissions`) are the ONLY source of role
//     authority. A document field named `role`, `isAdmin`, `admin`, etc.
//     inside `userProfiles` or any other collection NEVER grants access —
//     it exists only as a display/query mirror. Rules must never read a
//     document's own fields to decide whether the *caller* is an admin.
//   - There is no email-based admin check anywhere in these rules.
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role/permission authority: custom claims on the caller's ID token
    // ONLY. Never derived from a document field.
    function callerRole() {
      return isSignedIn() ? request.auth.token.get('role', null) : null;
    }

    function callerPermissions() {
      return isSignedIn() ? request.auth.token.get('permissions', []) : [];
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'ADMIN';
    }

    function isStaff() {
      return isSignedIn() && callerRole() == 'STAFF';
    }

    function isStaffOrAdmin() {
      return isAdmin() || isStaff();
    }

    function isDeliveryPartner() {
      return isSignedIn() && callerRole() == 'DELIVERY_PARTNER';
    }

    // ADMIN implicitly holds every permission (mirrors the backend's
    // requirePermission() behavior — see audit §7).
    function hasPermission(key) {
      return isAdmin() || (isStaff() && key in callerPermissions());
    }

    // ── Default deny ──────────────────────────────────────────────────
    // Every collection must be explicitly opened below. This top-level
    // catch-all guarantees that any collection not yet migrated — or any
    // typo'd/unknown path — is denied for both reads and writes, for both
    // anonymous and authenticated callers.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Placeholder sections for future collections ────────────────────
    // Each block below is commented out intentionally. It documents the
    // intended shape (matching docs/firebase-migration-audit.md §30) so the
    // next phase only has to uncomment + verify with rules tests, not
    // design from scratch. Nothing here is active until uncommented.

    // match /userProfiles/{uid} {
    //   allow read: if isOwner(uid) || hasPermission('customers.manage');
    //   // Only non-sensitive self-service fields are writable by the
    //   // owner; role/isActive/permissions remain Function-only (Admin SDK).
    //   allow update: if isOwner(uid) &&
    //     request.resource.data.diff(resource.data).affectedKeys()
    //       .hasOnly(['name', 'phone', 'avatarUrl', 'updatedAt']);
    //   allow create, delete: if false; // Function-only (auth-register / admin)
    // }

    // ── Addresses (Phase 4) ──────────────────────────────────────────────
    // Read: owner only, direct client (no cross-document invariant to
    // protect on a read). Write: Function-only — "at most one
    // isDefault:true per user" is a cross-document invariant Rules cannot
    // safely enforce against a client racing two writes; see
    // addresses/addresses.function.ts, which does this inside a Firestore
    // transaction using the Admin SDK (which bypasses Rules entirely).
    match /addresses/{addressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── Catalog (Phase 3 — products/categories migrated) ────────────────
    // Public: read active documents only. STAFF/ADMIN (products.manage):
    // full read (including inactive, for the admin catalog UI) + write.
    // Only custom claims decide admin access — never a document field.
    match /categories/{categoryId} {
      allow read: if resource.data.isActive == true || isStaffOrAdmin();
      allow create, update, delete: if hasPermission('products.manage');
    }

    match /products/{productId} {
      allow read: if resource.data.isActive == true || isStaffOrAdmin();
      allow create, update, delete: if hasPermission('products.manage');
    }

    // match /brands/{brandId} {
    //   allow read: if resource.data.isActive == true || isStaffOrAdmin();
    //   allow write: if hasPermission('products.manage');
    // }

    // ── Product variants (Phase 4) ───────────────────────────────────────
    // Same public/admin split as products/categories above: public reads
    // active variants only; STAFF/ADMIN (products.manage) read everything
    // and write.
    match /productVariants/{variantId} {
      allow read: if resource.data.isActive == true || isStaffOrAdmin();
      allow create, update, delete: if hasPermission('products.manage');
    }

    // ── Inventory (Phase 4) ──────────────────────────────────────────────
    // NEVER directly writable by any client, including an admin's browser
    // — every write is transactional (stock reservation, order flow) and
    // must go through a Function using the Admin SDK. STAFF/ADMIN with
    // inventory.manage may read the raw stock/reserved numbers; everyone
    // else sees availableStock via the public `productVariants` doc
    // instead (denormalized by the same Functions that write here).
    match /inventory/{variantId} {
      allow read: if hasPermission('inventory.manage');
      allow write: if false;
    }

    // ── Cart (Phase 4) ────────────────────────────────────────────────
    // Read: owner only, direct client, for display. Write: Function-only
    // — cart mutations reserve stock transactionally alongside the cart
    // item write (see cart/cart.function.ts) and must never trust a
    // client-supplied price or total (docs/firebase-migration-audit.md
    // §27); a direct client write could not honor that invariant, so this
    // deliberately departs from the audit §30 draft's "direct client
    // writes acceptable" suggestion — see the Phase 4 completion report.
    match /carts/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
      match /items/{variantId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ── Wishlist (Phase 4) ───────────────────────────────────────────────
    // No authoritative computation involved (just a list of product
    // references) and duplicate-prevention comes for free from using the
    // product's own doc ID as the item's doc ID — direct client
    // read/write is safe here, matching the audit §30 draft exactly.
    match /wishlists/{uid} {
      match /items/{productId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Delivery zones / serviceable pincodes (Phase 5) ─────────────────
    // Public read (a pincode check happens pre-auth on the product/cart
    // page) — matches the products/categories public-read split.
    // delivery.manage may write; the order-creation transaction
    // (orders/orders.function.ts) re-reads and re-validates both
    // authoritatively via the Admin SDK regardless of what a client saw.
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if hasPermission('delivery.manage');
    }

    match /serviceablePincodes/{pincode} {
      allow read: if true;
      allow write: if hasPermission('delivery.manage');
    }

    // match /localities/{localityId} {
    //   allow read: if true;
    //   allow write: if hasPermission('delivery.manage');
    // }

    // ── Coupons (Phase 5) ────────────────────────────────────────────────
    // Deviation from the Phase 1 draft's "never listable" sketch: STAFF/
    // ADMIN with coupons.manage may read (needed for an admin coupon-list
    // UI) — but an ordinary customer still cannot read this collection at
    // all, since they hold no such permission; they only ever learn a
    // coupon's discount by submitting a code string to the
    // `validateCoupon` Callable, which resolves it server-side. Write
    // stays admin/staff-only either way.
    match /coupons/{code} {
      allow read: if hasPermission('coupons.manage');
      allow write: if hasPermission('coupons.manage');
    }

    match /couponUsages/{usageId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // order-creation Function only
    }

    // ── Reward-spin wheel (Phase 5) ──────────────────────────────────────
    // rewardConfigs stays STAFF/ADMIN-read-only: `probability` must never
    // reach a customer's browser (Rules cannot redact individual fields on
    // a read), so customers only ever see the sanitized shape returned by
    // the `getRewardWheel` Callable (rewards/rewards.function.ts).
    match /rewardConfigs/{configId} {
      allow read: if hasPermission('rewards.manage');
      allow write: if hasPermission('rewards.manage');
    }

    match /rewardCoupons/{code} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid || isStaffOrAdmin();
      allow write: if false; // rewards/rewards.function.ts (spin) / order-creation Function only
    }

    // ── Orders (Phase 5) ──────────────────────────────────────────────────
    // Write: false everywhere — the entire order-creation flow (stock
    // consumption, coupon/reward redemption, cart clearing, payment record)
    // is one Firestore transaction in orders/orders.function.ts using the
    // Admin SDK, which bypasses Rules entirely; a client-side write could
    // never be trusted to honor those cross-document invariants (audit
    // §13/§22/§27).
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || hasPermission('orders.manage'));
      allow write: if false;
      match /items/{itemId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
            || hasPermission('orders.manage'));
        allow write: if false;
      }
      match /statusHistory/{historyId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
            || hasPermission('orders.manage'));
        allow write: if false;
      }
    }

    match /paymentRecords/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || hasPermission('orders.manage'));
      allow write: if false; // Function-only — see audit §14
    }

    // ── Order idempotency / webhook dedup markers (Phase 5) ─────────────
    // Deliberately UNLISTED — the top-level default-deny catch-all above
    // already denies both collections to every client for both read and
    // write. Neither `orderIdempotency/{key}` (order-creation retry
    // bookkeeping) nor `webhookEvents/{eventId}` (Razorpay webhook dedup)
    // is ever meant to be visible to a browser; both are written and read
    // exclusively by Functions via the Admin SDK. Listed here only so a
    // future collection audit finds this decision documented rather than
    // assuming the omission was accidental — see
    // firestore.rules.test.ts's "unlisted Phase 5 collections" cases.

    // match /reviews/{reviewId} {
    //   allow read: if resource.data.isApproved == true ||
    //     (isSignedIn() && resource.data.userId == request.auth.uid) ||
    //     hasPermission('reviews.manage');
    //   allow write: if false; // Function-only — purchase verification can't be expressed in Rules
    // }

    // match /banners/{bannerId} {
    //   allow read: if resource.data.isActive == true &&
    //     request.time >= resource.data.startsAt && request.time <= resource.data.endsAt;
    //   allow write: if hasPermission('banners.manage');
    // }

    // match /notifications/{uid}/items/{notificationId} {
    //   allow read: if isOwner(uid);
    //   allow update: if isOwner(uid) &&
    //     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    //   allow create, delete: if false; // Function-only
    // }

    // match /walletTransactions/{uid}/ledger/{transactionId} {
    //   allow read: if isOwner(uid) || hasPermission('customers.manage');
    //   allow write: if false; // Function-only — balance computation must be transactional
    // }

    // match /referrals/{refereeId} {
    //   allow read: if isSignedIn() &&
    //     (resource.data.referrerId == request.auth.uid || refereeId == request.auth.uid) ||
    //     isStaffOrAdmin();
    //   allow write: if false; // Function-only
    // }

    // match /platformSettings/{key} {
    //   allow read: if resource.data.get('isPublic', false) == true || hasPermission('settings.manage');
    //   allow write: if hasPermission('settings.manage');
    // }

    // match /auditLogs/{logId} {
    //   allow read: if isAdmin();
    //   allow write: if false; // Function-only
    // }
  }
}
