# Firebase Cloud Functions — local environment template.
#
# Phase 1 requires NO variables here: config/environment.ts validates only
# optional, non-secret flags with safe defaults (NODE_ENV, CORS_ORIGINS).
# The Local Emulator Suite sets FUNCTIONS_EMULATOR / FIRESTORE_EMULATOR_HOST
# automatically — you do not need to set those yourself.
#
# Real secrets (Razorpay, Cloudinary, SMTP) are NEVER put in a .env file for
# this project, in the emulator or in production. They are provisioned via
# Firebase Functions secrets (Google Secret Manager) once the functions that
# need them exist — see firebase/README.md "Secrets" section. Do not copy
# values from ../../backend/.env into this file.

# Optional — comma-separated CORS allowlist for HTTPS functions.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5000
