# ── Backend environment ───────────────────────────────────────
NODE_ENV=development
PORT=4000

# Public URLs
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# CORS — comma-separated allowlist
CORS_ORIGINS=http://localhost:5173

# Database (Prisma)
DATABASE_URL="mysql://tsgecart:change_me_app@localhost:3306/tsgecart"

# Redis
REDIS_URL="redis://:change_me_redis@localhost:6379"

# JWT — use long random strings in production
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_different_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# bcrypt
BCRYPT_ROUNDS=12

# Cookies
COOKIE_SECRET=replace_with_random_cookie_secret
COOKIE_DOMAIN=localhost

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@tsgecart.com
SMTP_PASS=your_smtp_password
MAIL_FROM="TSG eCart <no-reply@tsgecart.com>"

# Seed admin (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@tsgecart.com
SEED_ADMIN_PASSWORD=Admin@12345
