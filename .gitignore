# Dependencies
node_modules/
.pnp
.pnp.js

# Lock file (regenerated on install; CI uses npm install)
package-lock.json

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma
backend/prisma/*.db

# Testing
coverage/
.nyc_output/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
*.local
.cache/
dist-ssr/

# Firebase — never commit real project config, credentials, or emulator state
firebase/.firebaserc
firebase/functions/lib/
firebase/functions/.env
firebase/functions/.env.*
!firebase/functions/.env.example
firebase/.emulator-data/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
*-debug.log
.firebase/

# Firebase migration — user-export artifacts (contain password hashes; the
# scripts that produce/consume them are NOT executed as part of this repo's
# automated tooling, but their output directory must never be committed)
backend/scripts/output/


# Production frontend environment
frontend/.env.production
