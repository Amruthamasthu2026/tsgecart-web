# Frontend environment (Vite — only VITE_* vars are exposed to the client)
VITE_API_URL=/api/v1
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Firebase Authentication demo flow (Firebase migration Phase 2 — added
# alongside the existing JWT-based auth above, does not replace it). See
# frontend/src/lib/firebase.ts and firebase/README.md. Values come from the
# Firebase Console (Project settings > General > Your apps > SDK setup and
# configuration) — safe to expose client-side, these are not secrets.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tsgecart.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tsgecart
VITE_FIREBASE_STORAGE_BUCKET=demo-tsgecart.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Set to "true" for local dev against the Firebase Local Emulator Suite
# (firebase/firebase.json — Auth :9099, Functions :5001). Leave unset/false
# to talk to a real Firebase project.
VITE_FIREBASE_USE_EMULATOR=true

# Feature flag (Firebase migration Phase 3 — products/categories). When
# "true", Home/Products/Product-detail load data from Firestore
# (services/firebaseProducts.ts) instead of the existing Express catalog
# API (features/catalog/catalog.api.ts, untouched). Leave unset/false (the
# default) to keep every page on the existing Express API.
VITE_USE_FIRESTORE_PRODUCTS=false

# Feature flags (Firebase migration Phase 4 — variants/cart/wishlist/
# addresses). Each is independent; "true" switches that feature to
# Firestore (services/firebaseCart.ts, firebaseWishlist.ts,
# firebaseAddresses.ts). Requires being signed in via Firebase
# (/firebase-auth/login) — the existing JWT session cannot satisfy
# Firestore Security Rules. Leave unset/false (the default) to keep that
# feature on the existing Express API, unchanged.
VITE_USE_FIRESTORE_CART=false
VITE_USE_FIRESTORE_WISHLIST=false
VITE_USE_FIRESTORE_ADDRESSES=false
